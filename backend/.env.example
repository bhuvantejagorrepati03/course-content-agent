# ── LLM Provider ──────────────────────────────────────────────
# Set these to enable real AI responses.
# Leave LLM_API_KEY blank to run in MOCK/FALLBACK mode (good for demo).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Uploads ───────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db

# ── Vector Store ──────────────────────────────────────────────
CHROMA_PATH=data/chroma

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
